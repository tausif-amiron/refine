{
  "permissions": {
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Edit",
      "Write",
      "MultiEdit",
      "Skill",
      "Bash(npm run *)",
      "Bash(npm test*)",
      "Bash(npx vitest *)",
      "Bash(npx tsc *)",
      "Bash(npx playwright test*)",
      "Bash(pnpm install*)",
      "Bash(pnpm add *)",
      "Bash(pnpm test*)",
      "Bash(pnpm run *)",
      "Bash(pnpm exec vitest*)",
      "Bash(npm install*)",
      "Bash(npm ci*)",
      "Bash(yarn add *)",
      "Bash(yarn install*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(ls*)",
      "Bash(pwd)",
      "mcp__playwright",
      "Bash(node tools/ai-sdlc/checks/hooks/run-checks.mjs*)",
      "Bash(echo *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(grep *)",
      "Bash(sort *)",
      "Bash(diff *)",
      "Bash(true *)",
      "Bash(npx jest *)",
      "Bash(npx eslint *)",
      "Bash(pnpm exec *)",
      "Bash(yarn test*)",
      "Bash(yarn run *)"
    ],
    "ask": ["Bash(git push*)"],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Edit(./.env*)",
      "Write(./.env*)",
      "Bash(printenv*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/tools/ai-sdlc/checks/hooks/guard-files.mjs\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/tools/ai-sdlc/checks/hooks/guard-bash.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/tools/ai-sdlc/checks/hooks/post-edit.mjs\"",
            "timeout": 300
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/tools/ai-sdlc/checks/hooks/tool-telemetry.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/tools/ai-sdlc/checks/hooks/stop.mjs\"",
            "timeout": 900
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/tools/ai-sdlc/checks/hooks/stop.mjs\" --telemetry-only",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "$schema": "https://json.schemastore.org/claude-code-settings.json"
}
