{
  "$comment": "Stack profile: everything the workflow needs to know about one language ecosystem. See docs/ARCHITECTURE.md#stack-profiles.",
  "name": "node",
  "description": "JavaScript and TypeScript (npm, pnpm, yarn, bun)",
  "detect": [
    "package.json"
  ],
  "sourceExtensions": [
    ".js",
    ".jsx",
    ".ts",
    ".tsx",
    ".mjs",
    ".cjs",
    ".mts",
    ".cts"
  ],
  "manifests": [
    "package.json",
    "package-lock.json",
    "npm-shrinkwrap.json",
    "pnpm-lock.yaml",
    "pnpm-workspace.yaml",
    "yarn.lock",
    "bun.lockb"
  ],
  "packages": {
    "install": {
      "pattern": "\\b(?:npm|pnpm|yarn|bun)\\s+(?:i|install|add|ci)\\b([^;&|]*)",
      "name": "^(@[^/@\\s]+/[^@\\s]+|[^@\\s]+)",
      "flagsWithValue": [
        "--filter",
        "-F",
        "--workspace"
      ]
    },
    "forbidden": [
      {
        "pattern": "\\b(?:npm|pnpm|yarn)\\s+(?:publish|login|adduser)\\b",
        "why": "publishes or logs in to a registry"
      }
    ]
  },
  "dependencies": {
    "reader": "json-fields",
    "file": "package.json",
    "fields": [
      "dependencies",
      "devDependencies"
    ]
  },
  "scripts": {
    "reader": "json-field",
    "file": "package.json",
    "field": "scripts",
    "known": [
      "typecheck",
      "lint",
      "test",
      "build",
      "test:integration"
    ],
    "command": {
      "test": "npm test --silent",
      "default": "npm run -s {script}"
    },
    "runs": "\\b(?:npm|pnpm|yarn)\\s+(?:run\\s+(?:-s\\s+)?)?{script}(?:\\s|$)"
  },
  "tests": {
    "globs": [
      "**/*.test.ts",
      "**/*.test.tsx",
      "**/*.spec.ts",
      "**/*.spec.tsx",
      "**/test/**/*.ts",
      "**/e2e/**/*.ts"
    ],
    "report": "jest-json",
    "runners": [
      {
        "whenDependency": "vitest",
        "command": "npx vitest run --reporter=json --outputFile={out} {files}"
      },
      {
        "whenDependency": "jest",
        "command": "npx jest --json --outputFile={out} {files}"
      }
    ],
    "runnerPattern": "\\b(?:vitest|jest)\\b",
    "pinPattern": "(^|[\\s>\u203a])pin: "
  },
  "lint": {
    "whenDependency": "eslint",
    "lintChanged": "npx eslint",
    "format": "eslint-json",
    "configFiles": [
      "eslint.config.js",
      "eslint.config.mjs",
      "eslint.config.ts",
      ".eslintrc",
      ".eslintrc.js",
      ".eslintrc.json",
      ".eslintrc.cjs",
      "biome.json",
      ".prettierrc",
      "prettier.config.js"
    ],
    "stdinArgs": "--format json --stdin --stdin-filename '{file}'"
  },
  "mutation": {
    "operators": "js"
  },
  "routes": {
    "pattern": "\\b(?:router|app|server)\\.(get|post|put|patch|delete)\\s*\\(",
    "authPattern": "requireAuth|authenticate|@public",
    "sourceDirs": [
      "apps/api/src"
    ]
  },
  "app": {
    "startScripts": [
      "dev",
      "start"
    ]
  },
  "permissions": [
    "Bash(npm run *)",
    "Bash(npm test*)",
    "Bash(npx vitest *)",
    "Bash(npx jest *)",
    "Bash(npx tsc *)",
    "Bash(npx eslint *)",
    "Bash(npx playwright test*)",
    "Bash(pnpm install*)",
    "Bash(pnpm add *)",
    "Bash(pnpm test*)",
    "Bash(pnpm run *)",
    "Bash(pnpm exec *)",
    "Bash(npm install*)",
    "Bash(npm ci*)",
    "Bash(yarn add *)",
    "Bash(yarn install*)",
    "Bash(yarn test*)",
    "Bash(yarn run *)"
  ],
  "environments": [
    "node_modules"
  ],
  "caches": [
    ".eslintcache"
  ]
}
