{
  "$comment": "Stack profile: everything the workflow needs to know about one language ecosystem. See docs/ARCHITECTURE.md#stack-profiles.",
  "name": "python",
  "description": "Python (uv, pip, poetry, pdm; pytest, ruff, mypy)",
  "detect": [
    "pyproject.toml",
    "setup.py",
    "setup.cfg",
    "requirements.txt"
  ],
  "sourceExtensions": [
    ".py"
  ],
  "manifests": [
    "pyproject.toml",
    "uv.lock",
    "poetry.lock",
    "pdm.lock",
    "Pipfile",
    "Pipfile.lock",
    "requirements.txt",
    "requirements-dev.txt",
    "dev-requirements.txt",
    "setup.py",
    "setup.cfg"
  ],
  "packages": {
    "install": {
      "pattern": "\\b(?:uv\\s+add|uv\\s+pip\\s+install|pip3?\\s+install|python3?\\s+-m\\s+pip\\s+install|poetry\\s+add|pdm\\s+add|pipenv\\s+install)\\b([^;&|]*)",
      "name": "^([A-Za-z0-9][A-Za-z0-9._-]*)",
      "flagsWithValue": [
        "-r",
        "--requirement",
        "-c",
        "--constraint",
        "-e",
        "--editable",
        "-i",
        "--index-url",
        "--extra-index-url",
        "--group",
        "-G",
        "--optional"
      ],
      "skip": "^(\\.|\\.\\.|.*[/\\\\].*|.*\\.(txt|toml|cfg|whl|gz|zip))$"
    },
    "forbidden": [
      {
        "pattern": "\\b(?:twine\\s+upload|uv\\s+publish|poetry\\s+publish|flit\\s+publish|pdm\\s+publish|hatch\\s+publish)\\b",
        "why": "publishes to a package index"
      }
    ]
  },
  "dependencies": {
    "reader": "python"
  },
  "run": [
    {
      "whenFile": "uv.lock",
      "prefix": "uv run"
    },
    {
      "whenFile": "poetry.lock",
      "prefix": "poetry run"
    },
    {
      "whenFile": "pdm.lock",
      "prefix": "pdm run"
    },
    {
      "prefix": "python -m"
    }
  ],
  "checks": [
    {
      "whenDependency": "ruff",
      "command": "{run} ruff check .",
      "levels": [
        "fast",
        "full"
      ]
    },
    {
      "whenDependency": "mypy",
      "whenPath": "src",
      "command": "{run} mypy src",
      "levels": [
        "full"
      ]
    },
    {
      "whenDependency": "mypy",
      "unlessPath": "src",
      "command": "{run} mypy .",
      "levels": [
        "full"
      ]
    },
    {
      "whenDependency": "pytest",
      "command": "{run} pytest -q",
      "levels": [
        "full"
      ]
    }
  ],
  "scope": {
    "walk": [
      "tests/walk/**"
    ]
  },
  "tests": {
    "globs": [
      "**/test_*.py",
      "**/*_test.py",
      "**/tests/**/*.py",
      "**/test/**/*.py"
    ],
    "report": "junit",
    "runners": [
      {
        "whenDependency": "pytest",
        "command": "{run} pytest -q -p no:cacheprovider -o junit_family=xunit1 --junitxml={out} {files}"
      }
    ],
    "runnerPattern": "\\bpytest\\b",
    "pinPattern": "(^|\\.)test_pin_"
  },
  "lint": {
    "whenDependency": "ruff",
    "lintChanged": "{run} ruff check",
    "format": "ruff-json",
    "stdinArgs": "--output-format json --stdin-filename '{file}' -",
    "configFiles": [
      "ruff.toml",
      ".ruff.toml"
    ]
  },
  "mutation": {
    "operators": "python"
  },
  "routes": {
    "pattern": "@(?:app|router|api|bp|blueprint)\\.(get|post|put|patch|delete)\\(",
    "authPattern": "Depends\\(|login_required|requires_auth|permission_classes|@public",
    "sourceDirs": [
      "src",
      "app"
    ]
  },
  "permissions": [
    "Bash(uv run *)",
    "Bash(uv sync*)",
    "Bash(uv add *)",
    "Bash(uv pip install*)",
    "Bash(poetry run *)",
    "Bash(poetry install*)",
    "Bash(poetry add *)",
    "Bash(pdm run *)",
    "Bash(python -m pytest*)",
    "Bash(python -m ruff*)",
    "Bash(python -m mypy*)",
    "Bash(pytest*)",
    "Bash(ruff *)",
    "Bash(mypy *)",
    "Bash(pip install*)"
  ],
  "environments": [
    ".venv",
    "venv"
  ],
  "caches": [
    ".mypy_cache",
    ".ruff_cache",
    ".pytest_cache"
  ]
}
