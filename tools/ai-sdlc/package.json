{
  "name": "ai-sdlc",
  "version": "0.1.0",
  "private": true,
  "description": "AI-augmented SDLC workflow: ticket -> IR -> units -> agents -> checks -> QA -> score -> PR -> review -> approval -> release -> ops, built on Claude Code.",
  "type": "module",
  "scripts": {
    "build-ticket": "tsx orchestrator/cli.ts run",
    "check:claude-version": "node scripts/check-claude-version.mjs",
    "check:fast": "node checks/hooks/run-checks.mjs fast",
    "check:full": "node checks/hooks/run-checks.mjs full",
    "dashboard": "tsx scripts/report.ts --html .ai-sdlc/dashboard.html",
    "doctor": "tsx orchestrator/cli.ts doctor",
    "extract": "tsx orchestrator/cli.ts extract",
    "guards": "node checks/guards/no-secrets.mjs && node checks/guards/auth-endpoints.mjs && node checks/guards/docs-refs.mjs",
    "learn": "tsx orchestrator/cli.ts learn",
    "mutation": "tsx checks/mutation/run.ts",
    "ops:alert": "tsx orchestrator/cli.ts ops-alert",
    "ops:verify": "tsx orchestrator/cli.ts ops-verify",
    "plan": "tsx orchestrator/cli.ts plan",
    "pr": "tsx orchestrator/cli.ts pr",
    "qa": "tsx orchestrator/cli.ts qa",
    "release": "tsx orchestrator/cli.ts release",
    "report": "tsx scripts/report.ts",
    "review": "tsx orchestrator/cli.ts review",
    "score:finalize": "tsx orchestrator/cli.ts score-finalize",
    "score:probe": "tsx orchestrator/cli.ts score-probe",
    "simulator": "node simulator/server.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.322",
    "ajv": "8.20.0",
    "picomatch": "4.0.7",
    "tsx": "4.23.15",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/picomatch": "^4.0.0",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=20"
  }
}
