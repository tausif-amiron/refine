{
  "$comment": "Per-repo settings for the AI-SDLC workflow. Paths are relative to the client repo root. {workflow} is the workflow's folder ('.' here, 'tools/ai-sdlc' when installed); ${VAR} reads the environment. See docs/ARCHITECTURE.md#configuration.",
  "profiles": ["node"],
  "ticketPrefix": "JIRA",
  "branchPrefix": "feature/",
  "attemptsPerUnit": 3,
  "escalationModel": {
    "model": "opus",
    "attempts": 1
  },
  "budgetUsdPerTicket": 40,
  "budgetUsdPerRun": 5,
  "concurrency": 2,
  "models": {
    "extract": "opus",
    "plan": "sonnet",
    "dev-frontend": "sonnet",
    "dev-backend": "sonnet",
    "foundation": "opus",
    "qa": "sonnet",
    "score": "sonnet",
    "review": "${REVIEW_MODEL}",
    "release": "sonnet",
    "ops": "sonnet",
    "dev-wiring": "sonnet",
    "dev-module": "sonnet"
  },
  "scope": {
    "foundation": [
      "apps/api/src/core/**",
      "apps/api/test/core/**",
      "apps/web/src/core/**",
      "apps/web/test/core/**",
      "package.json",
      "package-lock.json",
      "pnpm-lock.yaml",
      "yarn.lock",
      "apps/*/package.json"
    ],
    "data-model": [
      "apps/api/src/models/{name}/**",
      "apps/api/test/models/{name}/**",
      "apps/api/migrations/*{name}*"
    ],
    "service": [
      "apps/api/src/services/{name}/**",
      "apps/api/test/services/{name}/**"
    ],
    "legacy-wrapper": [
      "apps/api/src/wrappers/{name}/**",
      "apps/api/test/wrappers/{name}/**"
    ],
    "screen": [
      "apps/web/src/screens/{name}/**",
      "apps/web/test/screens/{name}/**"
    ],
    "wiring": [
      "apps/web/src/routes/**",
      "apps/web/src/routes.*",
      "apps/web/src/nav/**",
      "apps/web/src/app.*",
      "apps/api/src/app.*",
      "apps/api/src/routes/**",
      "apps/api/src/server.*",
      "apps/web/test/wiring/**",
      "apps/api/test/wiring/**"
    ],
    "walk": ["packages/*/test/walk/**", "examples/*/test/walk/**"],
    "always": ["owed.yaml"]
  },
  "tests": {
    "globs": [
      "**/*.test.ts",
      "**/*.test.tsx",
      "**/*.spec.ts",
      "**/*.spec.tsx",
      "**/test/**/*.ts",
      "**/e2e/**/*.ts"
    ],
    "command": "TZ=UTC npx vitest run --reporter=json --outputFile={out} {files}",
    "external": ["cypress/e2e/**/*.cy.ts"]
  },
  "checks": {
    "fast": [],
    "full": [
      "node {workflow}/checks/guards/no-secrets.mjs",
      "node {workflow}/checks/guards/auth-endpoints.mjs"
    ],
    "integration": [],
    "contract": ["node {workflow}/checks/contract/verify.mjs"]
  },
  "services": [
    {
      "name": "simulator",
      "start": "node {workflow}/simulator/server.mjs",
      "url": "http://localhost:4010",
      "healthPath": "/healthz",
      "readyTimeoutSeconds": 20,
      "env": {
        "SIMULATOR_PORT": "4010"
      }
    },
    {
      "name": "app",
      "start": "${APP_START_COMMAND}",
      "url": "${APP_URL}",
      "healthPath": "/",
      "readyTimeoutSeconds": 180,
      "env": {}
    }
  ],
  "worktreeLinks": [],
  "guards": {
    "routePattern": "\\b(?:router|app|server)\\.(get|post|put|patch|delete)\\s*\\(",
    "authPattern": "requireAuth|authenticate|@public",
    "sourceDirs": ["apps/api/src"]
  },
  "mutation": {
    "fastSubset": 8,
    "catalogue": "{workflow}/checks/mutation/catalogue.yaml",
    "skip": ["examples/**"]
  },
  "jira": {
    "readyStatus": "To Do",
    "doneOnMerge": true,
    "needsAnswersStatus": "Needs answers",
    "stages": {
      "escalated": "Blocked",
      "inReview": "In Review",
      "released": "Done"
    },
    "fixDeployedStatus": "Fix deployed",
    "acceptanceCriteriaHeading": "Acceptance criteria",
    "opsLabel": "ai-ops"
  },
  "release": {
    "stages": [10, 50, 100],
    "healthUrl": "${HEALTH_URL}",
    "deployCommand": "${DEPLOY_COMMAND}",
    "rollbackCommand": "${ROLLBACK_COMMAND}",
    "watchMinutes": 30,
    "errorRateThreshold": 0.02
  },
  "ops": {
    "preApprovedActions": ["restart", "rollback", "scale"],
    "actionCommands": {
      "restart": "${OPS_RESTART_COMMAND}",
      "rollback": "${ROLLBACK_COMMAND}",
      "scale": "${OPS_SCALE_COMMAND}"
    },
    "dedupWindowMinutes": 60,
    "maxTicketsPerServicePerHour": 3,
    "verifyWindowMinutes": 120,
    "metricCommand": "${OPS_METRIC_COMMAND}"
  },
  "gateway": {
    "url": "${LITELLM_URL}",
    "keys": {
      "default": "LITELLM_KEY",
      "review": "LITELLM_KEY_REVIEW"
    },
    "headers": {
      "x-litellm-tags": "ticket:{ticket},agent:{agent}"
    }
  },
  "paperclip": {
    "url": "http://127.0.0.1:3100",
    "companyId": "4f59962e-add6-400a-99ee-b29d04433718",
    "agentId": "03d48900-f0ae-47db-9a60-d1a3189b65cb",
    "project": "RT",
    "projectId": "f9f71745-8a94-4f63-b91c-4afeb2158b6e",
    "report": true
  },
  "telemetry": {
    "file": ".ai-sdlc/telemetry/events.jsonl"
  },
  "pr": {
    "remote": "fork",
    "repo": "tausif-amiron/refine",
    "base": "main"
  },
  "workflow": {
    "version": "stable"
  },
  "monorepo": {
    "packages": "auto",
    "checks": {
      "fast": ["npx biome check {dir}", "pnpm --filter {name} types"],
      "full": [
        "npx biome check {dir}",
        "pnpm --filter {name} types",
        "TZ=UTC pnpm --filter {name} test",
        "pnpm --filter {name} build"
      ]
    },
    "tests": {
      "command": "TZ=UTC npx vitest run --root {dir} --reporter=json --outputFile={out} {files}"
    }
  }
}
